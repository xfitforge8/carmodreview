<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.carmodreview.daily-post</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/raykim/carmodreview/.venv/bin/python</string>
    <string>/Users/raykim/carmodreview/upload.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/raykim/carmodreview</string>

  <!-- 09:20 local, not 16:20. A Short's first two hours decide whether the
       algorithm keeps showing it, and 09:20 Pacific is lunchtime on the east
       coast and mid-afternoon in the UK -- a full day of US traffic ahead of
       it. 16:20 Pacific spends the useful window on people already going to
       bed. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>9</integer>
    <key>Minute</key><integer>20</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/raykim/carmodreview/social/upload.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/raykim/carmodreview/social/upload.log</string>

  <!-- If the Mac is asleep at 09:20, launchd runs the job at the next wake
       rather than skipping the day. RunAtLoad stays false so loading the
       agent does not post anything immediately. -->
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
